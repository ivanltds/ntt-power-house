# Copie para .env e preencha. O .env não deve ser versionado.
# LLM_PROVIDER: deepseek | mock  (sem chave ou sem internet, o sistema cai para o mock)
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Tempo máximo por chamada à IA, em milissegundos
DEEPSEEK_TIMEOUT_MS=45000
