# Copie para .env e preencha. O .env não deve ser versionado.
# LLM_PROVIDER: azure | deepseek | mock  (sem chave ou sem internet, o sistema cai para o mock)
# Sem LLM_PROVIDER: azure se AZURE_OPENAI_ENDPOINT estiver preenchido; senão deepseek.
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Tempo máximo por chamada à IA, em milissegundos
DEEPSEEK_TIMEOUT_MS=45000

# Azure OpenAI. Endpoint do recurso (ex.: https://<recurso>.openai.azure.com/) e nome da implantação (deployment).
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
# Chave do recurso. Vazia no App Service = usa a identidade gerenciada do web app (papel Cognitive Services OpenAI User).
AZURE_OPENAI_API_KEY=
# true para modelos de raciocínio (famílias o e gpt-5). Se ficar false, o Radar detecta sozinho na primeira recusa da API.
AZURE_OPENAI_REASONING=false
AZURE_OPENAI_REASONING_EFFORT=low
AZURE_OPENAI_TIMEOUT_MS=45000
# Opcional: endereço completo da API, se não for <endpoint>/openai/v1
AZURE_OPENAI_BASE_URL=

# Pasta dos dados gravados (banco, índice, envios, conversas). Vazio = data/
RADAR_DATA_DIR=
# Modo do diário do SQLite: WAL (padrão) ou DELETE (obrigatório em disco de rede, como o /home do Azure App Service)
RADAR_SQLITE_JOURNAL=
# Imagens dos tickets: chave gratuita do ImgBB (https://api.imgbb.com). Vazio = imagens não são guardadas
IMGBB_API_KEY=
# Chave (24+ caracteres) do endpoint de leitura para agentes: GET /api/relatorio/qualidade
RADAR_RELATORIO_TOKEN=
