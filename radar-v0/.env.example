# Copie para .env e preencha. O .env não deve ser versionado.
# LLM_PROVIDER: deepseek | mock  (sem chave ou sem internet, o sistema cai para o mock)
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Tempo máximo por chamada à IA, em milissegundos
DEEPSEEK_TIMEOUT_MS=45000
# Imagens dos tickets: chave gratuita do ImgBB (https://api.imgbb.com). Vazio = imagens não são guardadas
IMGBB_API_KEY=
# Chave (24+ caracteres) do endpoint de leitura para agentes: GET /api/relatorio/qualidade
RADAR_RELATORIO_TOKEN=
